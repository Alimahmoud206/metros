# Server
PORT=3000

# MongoDB Atlas connection string — connects to the "metros" database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/metros?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Seed admin (used by seed/seed.js to create the first admin account)
ADMIN_EMAIL=admin@metro.com
ADMIN_PASSWORD=Admin123!
