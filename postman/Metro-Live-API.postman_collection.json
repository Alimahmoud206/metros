              "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"_id\": \"66ff8a001d1c2e3f4a5b6c01\",\n      \"name\": \"Al Shohadaa\",\n      \"line\": \"Line 1\",\n      \"order\": 1\n    },\n    {\n      \"_id\": \"66ff8a001d1c2e3f4a5b6c02\",\n      \"name\": \"Nasser\",\n      \"line\": \"Line 1\",\n      \"order\": 2\n    },\n    {\n      \"_id\": \"66ff8a001d1c2e3f4a5b6c03\",\n      \"name\": \"Attaba\",\n      \"line\": \"Line 2\",\n      \"order\": 3\n    }\n  ]\n}"
